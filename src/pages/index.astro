---
import '../styles/global.css';
import { localeMeta, locales } from '../lib/i18n';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#F3F0E8" />
    <title>FormaSL</title>
    <meta name="description" content="FormaSL — Forma Semantic Language" />
    <link rel="canonical" href="https://formasl.org/" />
    {locales.map((locale) => <link rel="alternate" hreflang={localeMeta[locale].htmlLang} href={`https://formasl.org/${locale}/`} />)}
    <link rel="alternate" hreflang="x-default" href="https://formasl.org/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FormaSL" />
    <meta property="og:title" content="FormaSL" />
    <meta property="og:description" content="FormaSL — Forma Semantic Language" />
    <meta property="og:url" content="https://formasl.org/" />
    <meta property="og:image" content="https://formasl.org/og/en.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://formasl.org/og/en.png" />
  </head>
  <body>
    <main class="language-gateway">
      <section class="language-card">
        <img src="/brand/formasl.svg" alt="FormaSL" width="210" height="56" />
        <p class="eyebrow">Forma Semantic Language</p>
        <h1>Choose language</h1>
        <nav class="language-options" aria-label="Language">
          {locales.map((locale) => <a href={`/?locale=${locale}`} lang={localeMeta[locale].htmlLang}>{localeMeta[locale].label}</a>)}
        </nav>
      </section>
    </main>
  </body>
</html>
