---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { copy, localePath, locales, type Locale } from '../lib/i18n';
import { getPublishedPosts } from '../lib/blog';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = copy[locale];
const posts = await getPublishedPosts(locale);
const alternates = Object.fromEntries(locales.map((l) => [l, localePath(l, 'blog')]));
const title = `${c.blog} — FormaSL`;
---
<BaseLayout locale={locale} title={title} description={c.metaDescription} canonicalPath={localePath(locale, 'blog')} alternates={alternates}>
  <Header locale={locale} currentSection="blog" />
  <main class="shell editorial-page">
    <header class="page-title">
      <p class="eyebrow">FormaSL</p>
      <h1>{c.blog}</h1>
    </header>
    {posts.length ? (
      <div class="post-list">
        {posts.map((post) => (
          <article>
            <p class="post-meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString(locale === 'zh-hans' ? 'zh-CN' : locale)}</time>{post.data.category ? ` · ${post.data.category}` : ''}</p>
            <h2><a href={localePath(locale, `blog/${post.data.slug}`)}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    ) : <p class="muted">{c.noPosts}</p>}
  </main>
  <Footer locale={locale} />
</BaseLayout>
