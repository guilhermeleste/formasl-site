---
import LanguageSwitch from './LanguageSwitch.astro';
import { copy, glossaryPath, localePath, locales, type Locale } from '../lib/i18n';
import { site } from '../lib/site';

interface Props { locale: Locale; currentSection?: 'home' | 'blog' | 'glossary' | 'privacy'; }
const { locale, currentSection = 'home' } = Astro.props;
const c = copy[locale];
const paths = Object.fromEntries(locales.map((l) => [l,
  currentSection === 'blog' ? localePath(l, 'blog') :
  currentSection === 'glossary' ? glossaryPath(l) :
  currentSection === 'privacy' ? localePath(l, 'privacy') :
  localePath(l),
]));
---
<header class="site-header shell">
  <a class="brand-link" href={localePath(locale)} aria-label="FormaSL">
    <img src="/brand/formasl.svg" alt="FormaSL" width="210" height="56" />
  </a>
  <div class="header-actions">
    <nav class="main-nav" aria-label="Primary">
      <a href={localePath(locale, 'blog')}>{c.blog}</a>
      {site.githubUrl && <a href={site.githubUrl} rel="me">{c.github}</a>}
    </nav>
    <LanguageSwitch locale={locale} paths={paths} />
  </div>
</header>
