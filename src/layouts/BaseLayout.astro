---
import '../styles/global.css';
import { absoluteUrl, localeMeta, type Locale } from '../lib/i18n';
import { site } from '../lib/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternates?: Partial<Record<Locale, string>>;
  xDefaultPath?: string;
  socialImagePath?: string;
  ogType?: 'website' | 'article';
}

const {
  locale,
  title,
  description,
  canonicalPath,
  alternates = {},
  xDefaultPath = '/',
  socialImagePath = `/og/${locale}.png`,
  ogType = 'website',
} = Astro.props;

const canonical = absoluteUrl(canonicalPath);
const socialImage = absoluteUrl(socialImagePath);
const htmlLang = localeMeta[locale].htmlLang;
const ogLocale: Record<Locale, string> = {
  en: 'en_US',
  'pt-br': 'pt_BR',
  'zh-hans': 'zh_CN',
};
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F3F0E8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {Object.entries(alternates).map(([lang, path]) => (
      <link rel="alternate" hreflang={localeMeta[lang as Locale].htmlLang} href={absoluteUrl(path!)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefaultPath)} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {Object.keys(alternates).filter((lang) => lang !== locale).map((lang) => (
      <meta property="og:locale:alternate" content={ogLocale[lang as Locale]} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — ${localeMeta[locale].label}`} href={absoluteUrl(`/${locale}/rss.xml`)} />
  </head>
  <body>
    <slot />
  </body>
</html>
